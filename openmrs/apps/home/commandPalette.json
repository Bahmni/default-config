{
  "searchAnnotations": [
    {
      "prefix": "@phone",
      "label": "Phone",
      "fieldType": "person",
      "fieldsToSearch": ["phoneNumber"]
    },
    {
      "prefix": "@email",
      "label": "Email",
      "fieldType": "person",
      "fieldsToSearch": ["email"]
    }
  ],
  "trigger": {
    "type": "combination",
    "keys": "cmd+k",
    "interval": 350
  },
  "navItems": [
    {
      "id": "registration",
      "label": "Go to Registration",
      "path": "/bahmni-new/registration/search",
      "icon": "fa-registered",
      "newTab": true
    },
    {
      "id": "appointments",
      "label": "Go to Appointments",
      "path": "/bahmni-new/appointments/search",
      "icon": "fa-calendar-alt",
      "newTab": false
    },
    {
      "id": "createnew",
      "label": "Create New Patient",
      "path": "/bahmni-new/registration/patient/new",
      "icon": "fa-calendar-alt"
    },
    {
      "id": "bahmniwiki",
      "label": "Bahmni Wiki",
      "path": "https://bahmni.atlassian.net/wiki/spaces/BAH/overview",
      "icon": "fa-calendar-alt"
    },
    {
      "id": "openmrs",
      "label": "Openmrs",
      "path": "/openmrs",
      "icon": "fa-calendar-alt",
      "newTab": true
    },
    {
      "id": "bedmanagement",
      "label": "Bed Management",
      "path": "/bahmni/bedmanagement/",
      "icon": "fa-calendar-alt"
    },
    {
      "id": "OperatingTheatre",
      "label": "Operating Theatre",
      "path": "/bahmni/ot/",
      "icon": "fa-calendar-alt"
    }
  ],
  "patientActions": [
    {
      "id": "registration",
      "label": "Registration",
      "icon": "fa-clipboard-list",
      "pathTemplate": "/bahmni-new/registration/patient/{uuid}"
    },
    {
      "id": "clinical",
      "label": "Clinical",
      "icon": "fa-stethoscope",
      "pathTemplate": "/bahmni-new/clinical/{uuid}"
    }
  ],
  "patientFields": {
    "primaryFields": ["name", "identifier"],
    "additionalFields": ["age", "gender", "birthDate", "addressFieldValue", "customAttribute"]
  }
}
